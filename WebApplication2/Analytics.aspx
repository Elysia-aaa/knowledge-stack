<%@ Page Language="C#" MasterPageFile="~/Site.Master" %>
<asp:Content ID="AnalyticsContent" ContentPlaceHolderID="MainContent" runat="server">
 <div class="studio-page analytics-page" id="analyticsRoot">
  <header class="studio-heading"><div><p class="eyebrow">CREATOR STUDIO</p><h1>让每一份创作，被看见<span class="title-dot">.</span></h1><p class="muted">了解阅读，观察成长，找到下一篇值得写的内容。</p></div><button type="button" class="btn btn-ghost" id="refreshAnalytics">刷新数据</button></header>
  <div id="analyticsMessage" role="status" class="studio-message" hidden></div>
  <div id="analyticsContent" hidden>
   <div class="studio-toolbar"><div class="date-presets" aria-label="日期范围"><button type="button" data-range="7">近7天</button><button type="button" data-range="30" class="active">近30天</button><button type="button" data-range="90">近90天</button><button type="button" data-range="all">累计</button></div><div class="custom-dates"><label>开始<input type="date" id="analyticsFrom" /></label><span>—</span><label>结束<input type="date" id="analyticsTo" /></label><button type="button" class="btn btn-sm btn-ghost" id="applyDates">应用</button></div></div>
   <div class="analytics-scope"><div><span id="dataScope" class="studio-pill">全部文章</span><span class="muted" id="analyticsPeriod"></span></div><button type="button" class="text-button" id="clearSelection" hidden>返回全部文章</button></div>
   <div class="creator-overview"><div><span>累计阅读</span><strong id="totalViews">—</strong><small>内容被发现的每一次</small></div><div><span>当前粉丝</span><strong id="totalFollowers">—</strong><small>与你一起成长的读者</small></div><div><span>公开作品</span><strong id="totalPosts">—</strong><small>已发布且公开的文章</small></div><div class="overview-note"><span class="overview-spark" aria-hidden="true">✦</span><p>持续记录，<br />让知识发生连接。</p></div></div>
   <div id="analyticsMetrics" class="analytics-metrics"></div>
   <section class="chart-grid main-charts"><div class="card chart-panel"><div class="section-title"><div><p class="eyebrow">CONTENT PERFORMANCE</p><h2 id="trendTitle">阅读趋势</h2></div><button type="button" id="exportChart" class="text-button">保存图表</button></div><div class="chart-metrics" id="trendMetrics"></div><div class="chart-frame"><canvas id="trendChart" role="img" aria-label="所选日期范围的文章指标趋势"></canvas></div><p class="chart-caption" id="trendCaption"></p></div><div class="card chart-panel"><div class="section-title"><div><p class="eyebrow">ENGAGEMENT</p><h2>当前互动构成</h2></div></div><div class="chart-frame donut-frame"><canvas id="interactionChart" role="img" aria-label="当前点赞收藏评论转发的构成"></canvas></div><div id="interactionLegend" class="interaction-legend"></div></div></section>
   <section class="engagement-grid" id="readingQuality"></section>
   <section class="chart-grid secondary-charts"><div class="card chart-panel"><div class="section-title"><div><p class="eyebrow">AUDIENCE GROWTH</p><h2>粉丝成长</h2></div><span class="muted">作者整体</span></div><p class="fans-summary" id="fansSummary"></p><div class="chart-frame small-chart"><canvas id="fansChart" role="img" aria-label="粉丝新增取关和总量变化"></canvas></div><p class="chart-caption">新增与取关分开记录，净增允许为负数。</p></div><div class="card chart-panel"><div class="section-title"><div><p class="eyebrow">TOP CONTENT</p><h2>文章热度排行</h2></div><span class="muted">当前有效互动</span></div><div class="chart-frame small-chart"><canvas id="heatChart" role="img" aria-label="本人文章热度排行"></canvas></div><p class="chart-caption">热度＝点赞×3＋收藏×4＋有效评论×2。</p></div></section>
   <section class="card article-analysis"><div class="section-title"><div><p class="eyebrow">ARTICLE INSIGHTS</p><h2>每篇创作，都有自己的轨迹</h2></div><button type="button" class="btn btn-sm btn-ghost" id="exportAnalytics">导出 CSV</button></div><div class="article-table-tools"><input type="search" id="articleSearch" placeholder="搜索文章标题" aria-label="搜索文章标题" /><select id="articleStatus" aria-label="筛选文章状态"><option value="">全部状态</option><option>已发布</option><option>草稿</option><option>回收站</option><option>已隐藏</option></select><select id="articleCategory" aria-label="筛选文章学科"><option value="">全部学科</option></select><select id="articleSort" aria-label="文章排序"><option value="heat">热度最高</option><option value="views">区间阅读最多</option><option value="total">累计阅读最多</option><option value="likes">点赞最多</option><option value="date">最新创建</option></select><button type="button" id="compareArticles" class="btn btn-sm">对比所选（最多3篇）</button></div><p class="muted">列表筛选只影响下方文章；点击“分析”查看单篇，或勾选最多3篇对比。粉丝始终为作者整体数据。</p><div class="analytics-table-wrap"><table class="analytics-table"><thead><tr><th aria-label="选择文章"></th><th>文章</th><th>区间阅读</th><th>累计阅读</th><th>点赞</th><th>评论</th><th>热度</th><th>操作</th></tr></thead><tbody id="analyticsArticles"></tbody></table></div><div id="articlePager" class="pagination"></div></section>
   <details class="card analytics-definitions"><summary>数据口径与采集说明</summary><p id="trackingCoverage"></p><ul><li>阅读量按同一读者、同一文章每天一次计算；作者浏览本人文章不计入。游客按浏览器识别，跨设备可能重复。</li><li>有效阅读时长为页面前台且60秒内有阅读操作的估算；正文末尾进入可视区域并有效阅读10秒记完读。完读率以新采集阅读为分母。</li><li>互动率＝在所选范围内阅读且对同篇文章有过赞、藏、评论或转发的去重读者÷独立读者。互动取消不会抹去曾经参与的行为记录。</li><li>新增互动是时间范围内实际发生的新增行为，当前点赞/收藏等是尚有效的关系；两者不同。热度按快照记录的有效互动状态延续，采集开始前留空。</li><li>历史未采集的粉丝增减、时长、完读不补造。累计总量保留；彻底删除文章会清除其单篇明细。</li><li>日期按北京时间。累计不做前期对比；其他范围对比上一等长周期，历史采集不足时注明。超过100天按月汇总。</li></ul></details>
   <p class="analytics-updated muted" id="analyticsUpdated"></p>
  </div>
 </div>
 <script src="Scripts/vendor/chart.umd.min.js"></script>
 <script src="Scripts/analytics.js?v=20261026-real-only"></script>
</asp:Content>
